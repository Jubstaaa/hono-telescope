{
  "name": "hono-telescope",
  "version": "1.1.1",
  "author": {
    "name": "İlker Balcılar",
    "email": "ilkerbalcilartr@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jubstaaa/hono-telescope.git"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/core/storage/storage-contract.d.ts",
      "import": "./dist/core/storage/storage-contract.js"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/bun": "^1.3.1",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@uiw/react-json-view": "^2.0.0-alpha.39",
    "@vitejs/plugin-react": "^4.0.0",
    "antd": "^5.12.0",
    "axios": "^1.13.1",
    "babel-plugin-import": "^1.13.8",
    "dayjs": "^1.11.23",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-perfectionist": "^5.11.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "hono": "^4.13.5",
    "prettier": "^3.0.0",
    "pretty-ms": "^8.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router": "^7.9.5",
    "terser": "^5.44.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.46.2",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "hono": ">=4.0.0"
  },
  "bugs": {
    "url": "https://github.com/jubstaaa/hono-telescope/issues"
  },
  "description": "Laravel Telescope-style debugging for Hono, with an MCP server so AI coding agents can read your app's live requests, exceptions and queries. Zero runtime dependencies.",
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/Jubstaaa"
    },
    {
      "type": "buy_me_a_coffee",
      "url": "https://buymeacoffee.com/jubstaa"
    }
  ],
  "homepage": "https://github.com/jubstaaa/hono-telescope#readme",
  "keywords": [
    "hono",
    "mcp",
    "model-context-protocol",
    "ai",
    "debugging",
    "monitoring",
    "telescope",
    "middleware",
    "observability",
    "performance",
    "typescript",
    "bun",
    "nodejs"
  ],
  "license": "MIT",
  "packageManager": "bun@1.3.1",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "bun dist/example",
    "build": "rm -rf dist src/core/dashboard/assets && vite build && bun run scripts/inline-assets.ts && tsc",
    "publishBuild": "bun run build && rm -rf dist/example dist/dashboard && find dist -name '*.test.*' -delete && rm -f dist/tsconfig.tsbuildinfo && bun run verify:dist",
    "verify:dist": "test ! -d dist/src || (echo 'dist/src/ exists — tsc emitted a duplicated tree, the entry point is stale' && exit 1) && node -e \"import('./dist/index.js').then(()=>console.log('dist loads on node'))\" && bun -e \"import('./dist/index.js').then(()=>console.log('dist loads on bun'))\"",
    "dev": "tsc --watch",
    "dev:example": "bun --hot src/example/index.ts",
    "dev:dashboard": "vite dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf node_modules dist",
    "prepublishOnly": "bun run publishBuild",
    "type-check": "tsc --noEmit && tsc -p tsconfig.dashboard.json",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
