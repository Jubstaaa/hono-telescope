{
    "extends": "@jubstaaa/config/tsconfig/library",
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "declarationMap": false,
        "jsx": "react-jsx",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "outDir": "./dist",
        "removeComments": true,
        "rootDir": "./src",
        "types": ["bun"],
        "paths": {
            "@/*": ["./src/*"]
        },
        "lib": ["ESNext", "DOM", "DOM.Iterable"]
    },
    "include": ["./src/**/*"],
    "exclude": ["node_modules", "dist", "src/dashboard"]
}
