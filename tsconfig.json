{
    "extends": "@jubstaa/config/tsconfig/library",
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "jsx": "react-jsx",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "removeComments": true,
        "types": ["bun"],
        "paths": {
            "@/*": ["./src/*"]
        },
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "noEmit": true
    },
    "include": [
        "types",
        "eslint.config.ts",
        "prettier.config.ts",
        "./src/**/*",
        "./scripts/**/*",
        "*.ts",
        "*.mts"
    ],
    "exclude": ["node_modules", "dist", "src/dashboard"]
}
